{
  "name": "WindLens Dev",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "installDockerBuildx": true
    }
  },
  "forwardPorts": [
    3000,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Frontend"
    },
    "8000": {
      "label": "Backend API"
    }
  },
  "remoteUser": "vscode",
  "build": {
    "dockerfile": "Dockerfile"
  }
}
